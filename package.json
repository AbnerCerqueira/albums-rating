  "name": "albums-rating",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "PROFILE=production node --env-file=.env.production dist/main.js",
    "dev": "PROFILE=development tsx watch --env-file=.env.development src/main.ts",
    "lint": "ultracite fix",
    "test": "PROFILE=test vitest run",
    "test:unit": "PROFILE=test vitest run --project unit",
    "test:e2e": "PROFILE=test vitest run --project e2e",
    "typecheck": "tsc --noEmit",
    "coverage": "PROFILE=test vitest run --coverage",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "type": "commonjs",
  "version": "1.0.0",
  "description": "API for music reviews",
  "main": "src/main.ts",
