    "uuidv7": "^1.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/lodash": "^4.17.23",
    "@types/node": "^24.10.0",
    "@types/node-cron": "^3.0.11",
