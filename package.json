{
  "name": "albums-rating",
  "version": "1.0.0",
  "description": "API for music reviews",
  "main": "src/main.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node --env-file=.env.production dist/main.js",
    "dev": "tsx watch --env-file=.env.development src/main.ts",
    "lint": "ultracite fix",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "author": "Abner Bispo Cerqueira",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@faker-js/faker": "^10.1.0",
    "@types/node": "^24.10.0",
    "mongodb-memory-server": "^10.3.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "ultracite": "^6.3.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.6.0",
    "@fastify/swagger-ui": "^5.2.3",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.6.2",
    "fastify-type-provider-zod": "^6.1.0",
    "mongodb": "^7.0.0",
    "mongoose": "^8.19.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "uninstall": "^0.0.0",
    "uuidv7": "^1.0.2",
    "zod": "^4.1.12"
  }
}
